        { "material": "screw", "at": [2.75, 16.75, 10.25], "dir": [0, -1, 0], "repeat": { "count": 2, "step": [30.5, 0, 0] } }
      ],
      "warn": [{ "type": "warning", "text": "When you drill, wear safety glasses. The bit can throw chips into your eyes." }],
      "do": ["Put the top on the frame.", "Install one screw through the top into each leg."],
      "check": "Make sure that each screw head is flush with the top."
