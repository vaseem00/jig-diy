    {
      "id": "stain", "phase": "Finish", "title": "Apply the stain", "minutes": 20, "wait": 120,
      "tools": ["gloves"], "finish": { "material": "stain" },
      "warn": [{ "type": "warning", "text": "Wear nitrile gloves. The stain can hurt your skin." }, { "type": "warning", "text": "Open a window. Stain fumes can make you ill." }],
      "do": ["Apply a thin coat of stain to all faces.", "Wipe off the extra stain after 10 minutes."],
      "check": "Make sure that the stain is dry before you use the bench."
