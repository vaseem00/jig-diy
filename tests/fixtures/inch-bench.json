      "warn": [{ "type": "warning", "text": "When you drill, wear safety glasses. The bit can throw chips into your eyes." }],
      "do": ["Clamp each rail between two legs.", "Install one screw through each leg into the rail."],
      "check": "Make sure that the frame stands flat on the floor."
